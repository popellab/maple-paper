  doi = {10.1093/bib/bbaa057},
  urldate = {2026-01-20},
  abstract = {The recent years have witnessed a rapid increase in the number of scientific articles in biomedical domain. These literature are mostly available and readily accessible in electronic format. The domain knowledge hidden in them is critical for biomedical research and applications, which makes biomedical literature mining (BLM) techniques highly demanding. Numerous efforts have been made on this topic from both biomedical informatics (BMI) and computer science (CS) communities. The BMI community focuses more on the concrete application problems and thus prefer more interpretable and descriptive methods, while the CS community chases more on superior performance and generalization ability, thus more sophisticated and universal models are developed. The goal of this paper is to provide a review of the recent advances in BLM from both communities and inspire new research directions.},
  file = {/Users/joeleliason/Zotero/storage/5286GBA3/Zhao et al. - 2021 - Recent advances in biomedical literature mining.pdf}
}

@article{craigPracticalGuideGeneration2023,
  title = {A Practical Guide for the Generation of Model-Based Virtual Clinical Trials},
  author = {Craig, Morgan and Gevertz, Jana L. and Kareva, Irina and Wilkie, Kathleen P.},
  year = 2023,
  month = jun,
  journal = {Frontiers in Systems Biology},
  volume = {3},
  publisher = {Frontiers},
  issn = {2674-0702},
  doi = {10.3389/fsysb.2023.1174647},
  urldate = {2025-06-19},
  abstract = {Mathematical modeling has made significant contributions to drug design, development, and optimization. Virtual clinical trials that integrate mathematical models to explore patient heterogeneity and its impact on a variety of therapeutic questions have recently risen in popularity. Here, we outline best practices for creating virtual patients from mathematical models to ultimately implement and execute a virtual clinical trial. In this practical guide, we discuss and provide examples of model design, parameter estimation, parameter sensitivity, model identifiability, and virtual patient cohort creation. Our goal is to help researchers adopt these approaches to further the use of virtual population-based analysis and virtual clinical trials.},
  langid = {english},
  keywords = {mathematical modelling,model identifiability,parameter estimation,sensitivity analysis,virtual clinical trials,Virtual patients},
  file = {/Users/joeleliason/Zotero/storage/TF7QJ935/Craig et al. - 2023 - A practical guide for the generation of model-based virtual clinical trials.pdf}
